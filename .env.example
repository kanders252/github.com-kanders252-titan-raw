# Postgres (Neon/Supabase: use the pooled URL here and the direct URL below)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/titan_raw?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/titan_raw?schema=public"

# NextAuth
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional locally)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email magic link (optional locally), e.g. smtp://user:pass@smtp.example.com:587
EMAIL_SERVER=""
EMAIL_FROM="TITAN-RAW <no-reply@example.com>"

# Local development and E2E only: enables a passwordless "dev login". NEVER set in production.
ENABLE_DEV_LOGIN="true"

# Calendar day boundary for daily logs (IANA tz)
APP_TIMEZONE="UTC"

# Optional: comma-separated emails allowed to run auditRecipe
ADMIN_EMAILS=""
