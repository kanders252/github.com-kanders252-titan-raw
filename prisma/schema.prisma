generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MealSlot {
  INFUSED_WATER
  BREAKFAST
  MORNING_SNACK
  LUNCH
  AFTERNOON_SNACK
  DINNER
  EVENING_SNACK
  DESSERT
}

enum RecipeCategory {
  JUICE
  SMOOTHIE
  SALAD
  SOUP
  DESSERT
  DIP
  SNACK
  MAIN
}

enum PlanCategory {
  BEGINNER
  DETOX
  WEIGHT_LOSS
  CUSTOM
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  image         String?
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
  dailyLogs     DailyLog[]
  mealPlans     MealPlan[]
  createdAt     DateTime   @default(now())
}

// ── NextAuth (Prisma adapter) ──────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Domain ─────────────────────────────────────────────────
model Recipe {
  id                String          @id @default(cuid())
  title             String
  category          RecipeCategory
  ingredients       Json // string[]
  instructions      Json // string[]
  badges            String[]
  isPremium         Boolean         @default(false)
  temperatureStatus String          @default("raw_under_115F")
  fatSource         String?
  keyMicronutrients String[]
  prepTechniques    String[]
  createdAt         DateTime        @default(now())
  mealPlanEntries   MealPlanEntry[]

  @@index([category])
}

model MealPlan {
  id           String          @id @default(cuid())
  userId       String?
  user         User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  durationDays Int // 3–21
  category     PlanCategory
  isTemplate   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  entries      MealPlanEntry[]
  dailyLogs    DailyLog[]

  @@index([userId])
  @@index([isTemplate])
}

model MealPlanEntry {
  id       String   @id @default(cuid())
  planId   String
  plan     MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  day      Int // 1-indexed
  slot     MealSlot
  recipeId String
  recipe   Recipe   @relation(fields: [recipeId], references: [id])

  @@unique([planId, day, slot])
}

model DailyLog {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime   @db.Date
  completedSlots  MealSlot[]
  infusedWaterOz  Int        @default(0)
  // Additive: links a day to an active plan (set by startMealPlan)
  planId          String?
  plan            MealPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  planDay         Int?
  // Additive: { [MealSlot]: recipeId } for manual "Assign Recipe" when no plan is active
  assignedRecipes Json       @default("{}")

  @@unique([userId, date])
  @@index([planId])
}
